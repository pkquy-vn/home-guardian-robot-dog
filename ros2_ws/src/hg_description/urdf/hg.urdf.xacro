<?xml version="1.0"?>
<!--
  Home Guardian: minimal robot model (boxes and cylinders) for robot_state_publisher.
  SPDX-License-Identifier: Apache-2.0

  Frames: base_link at the body centre (x forward, y left, z up); the hip pitch axes are at
  x = +/-0.093 m, y = +/-0.095 m, z = 0. Foot frames: fl_foot, fr_foot, rl_foot, rr_foot.

  Joint values are the firmware conventions in radians (docs/kinematics.md), so /joint_states
  needs no conversion:
    <leg>_hip_joint:  hip angle. 0 = femur straight down, positive = femur forward.
                      Axis -y, so a positive value rotates the femur toward +x.
    <leg>_knee_joint: interior knee angle. pi (180 deg) = straight leg.
                      The joint origin is rotated by pi about y, so the tibia is aligned with the
                      femur at q = pi and folds back (knee forward) as q decreases.
  Identical conventions on all four legs; servo direction signs are a calibration concern.
-->
<robot name="home_guardian" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="deg" value="${pi / 180.0}"/>

  <xacro:property name="body_length" value="0.360"/>
  <xacro:property name="body_width" value="0.150"/>
  <xacro:property name="body_height" value="0.150"/>
  <xacro:property name="hip_x" value="0.093"/>
  <xacro:property name="hip_y" value="0.095"/>
  <xacro:property name="femur_length" value="0.108"/>
  <xacro:property name="tibia_length" value="0.130"/>

  <xacro:property name="hip_lower" value="${-45 * deg}"/>
  <xacro:property name="hip_upper" value="${100 * deg}"/>
  <xacro:property name="knee_lower" value="${30 * deg}"/>
  <xacro:property name="knee_upper" value="${150 * deg}"/>
  <!-- Placeholders until the servos are chosen. -->
  <xacro:property name="joint_effort" value="10.0"/>
  <xacro:property name="joint_velocity" value="6.0"/>

  <material name="body_grey"><color rgba="0.55 0.57 0.60 1.0"/></material>
  <material name="leg_dark"><color rgba="0.20 0.22 0.25 1.0"/></material>
  <material name="foot_black"><color rgba="0.05 0.05 0.05 1.0"/></material>

  <link name="base_link">
    <visual>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
  </link>

  <xacro:macro name="leg" params="prefix x y">
    <joint name="${prefix}_hip_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_femur"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${hip_lower}" upper="${hip_upper}" effort="${joint_effort}"
             velocity="${joint_velocity}"/>
    </joint>

    <link name="${prefix}_femur">
      <!-- Hip actuator, along the pitch axis. -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="0.025" length="0.040"/></geometry>
        <material name="leg_dark"/>
      </visual>
      <visual>
        <origin xyz="0 0 ${-femur_length / 2}" rpy="0 0 0"/>
        <geometry><box size="0.030 0.025 ${femur_length}"/></geometry>
        <material name="leg_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-femur_length / 2}" rpy="0 0 0"/>
        <geometry><box size="0.030 0.025 ${femur_length}"/></geometry>
      </collision>
    </link>

    <joint name="${prefix}_knee_joint" type="revolute">
      <parent link="${prefix}_femur"/>
      <child link="${prefix}_tibia"/>
      <origin xyz="0 0 ${-femur_length}" rpy="0 ${pi} 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${knee_lower}" upper="${knee_upper}" effort="${joint_effort}"
             velocity="${joint_velocity}"/>
    </joint>

    <link name="${prefix}_tibia">
      <visual>
        <origin xyz="0 0 ${-tibia_length / 2}" rpy="0 0 0"/>
        <geometry><cylinder radius="0.010" length="${tibia_length}"/></geometry>
        <material name="leg_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-tibia_length / 2}" rpy="0 0 0"/>
        <geometry><cylinder radius="0.010" length="${tibia_length}"/></geometry>
      </collision>
    </link>

    <!-- Foot contact point at the tibia tip. -->
    <joint name="${prefix}_foot_joint" type="fixed">
      <parent link="${prefix}_tibia"/>
      <child link="${prefix}_foot"/>
      <origin xyz="0 0 ${-tibia_length}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}_foot">
      <visual>
        <geometry><sphere radius="0.012"/></geometry>
        <material name="foot_black"/>
      </visual>
    </link>
  </xacro:macro>

  <xacro:leg prefix="fl" x="${hip_x}" y="${hip_y}"/>
  <xacro:leg prefix="fr" x="${hip_x}" y="${-hip_y}"/>
  <xacro:leg prefix="rl" x="${-hip_x}" y="${hip_y}"/>
  <xacro:leg prefix="rr" x="${-hip_x}" y="${-hip_y}"/>

</robot>
